    "table_header_pt": 10,
    "table_body_pt": 10
  },
  "headings": {
    "h1_color": "#000000",
    "h2_color": "#0B1EEA",
    "h3_color": "#000000",
    "h1_bold": true,
    "h2_bold": true,
    "h3_bold": true
  },
  "table": {
    "header_bg": "#0B1EEA",
    "header_fg": "#FFFFFF",
    "border_color": "#D0D0D0",
