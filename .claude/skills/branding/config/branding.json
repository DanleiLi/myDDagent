{
  "colors": {
    "primary_blue": "#0B1EEA",
    "violet": "#3A0CA3",
    "dark_purple": "#240046",
    "white": "#FFFFFF",
    "black": "#000000",
    "light_grey": "#D0D0D0",
    "inline_code_bg": "#E8E8E8",
    "code_block_bg": "#F2F2F2",
    "blockquote_border": "#A0A0A0",
    "blockquote_text": "#646464"
  },
  "callouts": {
    "NOTE": {
      "border": "#0B1EEA",
      "fill": "#EEF2FF"
    },
    "TIP": {
      "border": "#2D9E4F",
      "fill": "#EAFAF1"
    },
    "WARNING": {
      "border": "#F5A623",
      "fill": "#FFFBEA"
    },
    "IMPORTANT": {
      "border": "#D0342C",
      "fill": "#FEF2F2"
    }
  },
  "fonts": {
